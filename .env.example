# -----------------------------------------------------------------------------
# EASYPIE - ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in your actual credentials.
# -----------------------------------------------------------------------------

# --- Supabase Configuration ---
# Your Supabase Project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anon Key (found in Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Application General Settings ---
# The name of the platform
VITE_APP_NAME=EASYPIE

# Default currency symbol (NGN)
VITE_APP_CURRENCY=₦

# System timezone for calculations and displays
VITE_APP_TIMEZONE=Africa/Lagos

# --- Investment & Rewards ---
# Bonus amount automatically credited to new users (Naira)
VITE_WELCOME_BONUS=500

# Daily earnings distribution time (24-hour format, Africa/Lagos)
VITE_EARNINGS_TIME=00:00

# --- Community & Support ---
# Official Telegram community invitation link
VITE_TELEGRAM_LINK=https://t.me/+soUYHDmaOZBmM2U0

# --- Payment Details (Kuda Bank Only) ---
# The official Kuda Bank Account Name for user deposits
VITE_KUDA_ACCOUNT_NAME=YOUR_REGISTERED_NAME

# The official Kuda Bank Account Number for user deposits
VITE_KUDA_ACCOUNT_NUMBER=0000000000

# The bank name (Strictly Kuda Bank)
VITE_KUDA_BANK_NAME=Kuda Bank

# --- Administrative ---
# Primary administrator email address
VITE_ADMIN_EMAIL=admin@easypie.com
